<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PenguCrush" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#FFF2CF</item>
        <item name="android:colorAccent">#EF6047</item>
        <item name="android:statusBarColor">#FFF2CF</item>
        <item name="android:navigationBarColor">#FFF2CF</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.PenguCrush.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFF2CF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.PenguCrush</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
